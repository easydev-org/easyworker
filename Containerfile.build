# syntax=docker/dockerfile:1
# easyworker — BUILD ARTIFACTS only (no container image).
#
# Multi-stage: build the control-panel SPA from easyworker-webui, then the Go
# binary with the SPA embedded, and export BOTH via `--output type=local`:
#
#   buildctl ... build \
#     --opt filename=Containerfile.build \
#     --output type=local,dest=./dist
#   # -> dist/easyworker  dist/webui/
#
# Used by ./build.sh --artifacts. The final stage is `scratch`, so nothing is
# packaged as an image; only the two trees are emitted.
ARG REGISTRY=docker.io/library

# ---- webui (node) ----
FROM ${REGISTRY}/node:22-alpine AS webui
ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG EASYWORKER_WEBUI_REPO=https://github.com/easydev-org/easyworker-webui.git
ARG EASYWORKER_WEBUI_REF=main
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY}
RUN apk add --no-cache git ca-certificates \
    && git clone --depth 1 --branch "${EASYWORKER_WEBUI_REF}" "${EASYWORKER_WEBUI_REPO}" /webui \
    && cd /webui && npm ci --no-audit --no-fund && OUT_DIR=dist npm run build

# ---- build (go) ----
FROM ${REGISTRY}/golang:1.26-alpine AS build
ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY} \
    GOPROXY=https://proxy.golang.org GOSUMDB=off CGO_ENABLED=0 GOWORK=off
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . ./
COPY --from=webui /webui/dist/ internal/webui/dist/
RUN go build -trimpath -ldflags "-s -w" -o /out/easyworker ./cmd/easyworker

# ---- artifacts (no image) ----
FROM scratch AS artifacts
COPY --from=build /out/easyworker /bin/easyworker
COPY --from=webui /webui/dist /webui
