# Toolchain image: Deno (JS/TS runtime).
#
# Generic: the binary is pre-downloaded (fetch-artifacts.sh) and COPYed. Deno
# speaks the npm protocol and honors DENO_CERT (and SSL_CERT_FILE) for extra
# roots, which the stage-2 inject forwards.
ARG BASE_IMAGE=toolchain-base:debian-trixie
FROM ${BASE_IMAGE}
COPY cache/deno-x86_64-unknown-linux-gnu.zip /tmp/deno.zip
RUN unzip -q /tmp/deno.zip -d /usr/local/bin && chmod +x /usr/local/bin/deno && rm /tmp/deno.zip
ENV DENO_DIR=/opt/deno
RUN deno --version
