# Canonical upstream URLs for the debian-trixie toolchain artifacts. Sourced by
# build-toolchain.sh and passed to the Dockerfiles as build args; the Dockerfiles
# also carry them as ARG defaults, so they build standalone.
#
# Overrides go in ../urls.local.env (gitignored, e.g. written by mirror.sh).
# Version patterns + latest-version lookups: toolchain/VERSIONS.md.
# Pinned-vs-latest check: ./check-versions.sh
NODE_URL=https://nodejs.org/dist/v26.9.0/node-v26.9.0-linux-x64.tar.xz
GO_URL=https://go.dev/dl/go1.27.1.linux-amd64.tar.gz
PYTHON_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260901/cpython-3.14.7+20260901-x86_64-unknown-linux-gnu-install_only.tar.gz
# The ML images (torch/vllm/vllm-omni/comfyui/llamacpp) build on toolchain-cuda,
# which pins CPython 3.13 (vLLM-Omni requires <3.14; the ML ecosystem lags the
# distro's 3.14).
PYTHON313_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20260924/cpython-3.13.15+20260924-x86_64-unknown-linux-gnu-install_only.tar.gz
UV_URL=https://github.com/astral-sh/uv/releases/download/0.12.16/uv-x86_64-unknown-linux-gnu.tar.gz
RUST_URL=https://static.rust-lang.org/dist/2026-09-03/rust-1.98.1-x86_64-unknown-linux-gnu.tar.gz
# The `java` toolchain (generic JVM dev) uses the newest Temurin (26). The JVM
# *language* images (kotlin/scala/groovy/clojure) pin the LTS (25) for
# ecosystem compatibility and extend toolchain-java25, not toolchain-java.
JDK_URL=https://github.com/adoptium/temurin26-binaries/releases/download/jdk-26.0.2.1%2B1/OpenJDK26U-jdk_x64_linux_hotspot_26.0.2.1_1.tar.gz
JDK25_URL=https://github.com/adoptium/temurin25-binaries/releases/download/jdk-25.0.4.1%2B1/OpenJDK25U-jdk_x64_linux_hotspot_25.0.4.1_1.tar.gz
GRADLE_URL=https://services.gradle.org/distributions/gradle-9.7.1-bin.zip
DOTNET_URL=https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.401/dotnet-sdk-10.0.401-linux-x64.tar.gz
RUBY_URL=https://github.com/ruby/ruby-builder/releases/download/ruby-4.0.7/ruby-4.0.7-ubuntu-22.04-x64.tar.gz
# php: static-php-cli's bulk builds lag the php.net release (8.5.10 is out but
# the newest prebuilt CLI is 8.5.8); bump when upstream publishes it.
PHP_URL=https://dl.static-php.dev/static-php-cli/bulk/php-8.5.8-cli-linux-x86_64.tar.gz
COMPOSER_URL=https://getcomposer.org/download/2.10.3/composer.phar
OTP_URL=https://builds.hex.pm/builds/otp/ubuntu-22.04/OTP-29.1.tar.gz
ELIXIR_URL=https://builds.hex.pm/builds/elixir/v1.20.4-otp-29.zip
HEX_URL=https://repo.hex.pm/installs/1.20.4/hex-2.5.1-otp-29.ez
HEXKEY_URL=https://repo.hex.pm/installs/hex-registry-public-key.pem
DART_URL=https://storage.googleapis.com/dart-archive/channels/stable/release/3.13.4/sdk/dartsdk-linux-x64-release.zip
SWIFT_URL=https://download.swift.org/swift-6.4.0-release/debian13/swift-6.4.0-RELEASE/swift-6.4.0-RELEASE-debian13.tar.gz
CONDA_URL=https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh
# overridden per-libc in urls.local.env (CONAN_URL_GLIBC)
# pixi: conda + PyPI project environments. Upstream publishes only a static
# musl build; being fully static it runs on glibc too. It coexists with `conda`
# above (different workflows: lockfile environments vs the classic CLI).
PIXI_URL=https://github.com/prefix-dev/pixi/releases/latest/download/pixi-x86_64-unknown-linux-musl
CONAN_URL=https://artifacts.example.com/conan-wheels-2.32.0.tar.gz
# godot: official Linux editor build; doubles as the headless export CLI.
GODOT_URL=https://github.com/godotengine/godot/releases/download/4.7.2-stable/Godot_v4.7.2-stable_linux.x86_64.zip

# --- additional languages ---------------------------------------------------
# bun: JS/TS runtime + package manager (npm protocol).
BUN_URL=https://github.com/oven-sh/bun/releases/download/bun-v1.4.2/bun-linux-x64.zip
# deno: JS/TS runtime (npm protocol); upstream has no musl build.
DENO_URL=https://github.com/denoland/deno/releases/download/v2.9.7/deno-x86_64-unknown-linux-gnu.zip
# gleam: statically linked musl binary; package manager uses the hex protocol.
GLEAM_URL=https://github.com/gleam-lang/gleam/releases/download/v1.18.1/gleam-v1.18.1-x86_64-unknown-linux-musl.tar.gz
# JVM languages: all ride on the JDK (its cacerts carries the egress CA).
KOTLIN_URL=https://github.com/JetBrains/kotlin/releases/download/v2.4.20/kotlin-compiler-2.4.20.zip
GROOVY_URL=https://groovy.jfrog.io/artifactory/dist-release-local/groovy-zips/apache-groovy-binary-4.0.33.zip
CLOJURE_URL=https://download.clojure.org/install/clojure-tools-1.12.6.1673.tar.gz
# scala: scala-cli is the modern launcher; sbt remains the build-tool standard.
SCALA_CLI_URL=https://github.com/VirtusLab/scala-cli/releases/download/v1.17.1/scala-cli-x86_64-pc-linux.gz
SBT_URL=https://github.com/sbt/sbt/releases/download/v1.13.0/sbt-1.13.0.tgz

# clang/LLVM: the official prebuilt release (relocatable; includes clang, lld,
# libc++, llvm-config, cmake, ninja — but we install cmake/ninja as their own
# toolchains, so only clang+llvm is taken from here).
LLVM_URL=https://github.com/llvm/llvm-project/releases/download/llvmorg-23.1.2/LLVM-23.1.2-Linux-X64.tar.xz

# --- languages without an artifact protocol (git cache / plain HTTP) --------
# flutter: the SDK is a relocatable prebuilt per host platform (linux/web/android
# builds run from the linux SDK; windows/macos desktop packaging needs the
# matching host SDK). All four are plain tarballs/zip, unpack-and-go.
FLUTTER_LINUX_URL=https://storage.googleapis.com/flutter_infra_release/releases/stable/linux/flutter_linux_3.47.6-stable.tar.xz
FLUTTER_WINDOWS_URL=https://storage.googleapis.com/flutter_infra_release/releases/stable/windows/flutter_windows_3.47.6-stable.zip
FLUTTER_MACOS_URL=https://storage.googleapis.com/flutter_infra_release/releases/stable/macos/flutter_macos_3.47.6-stable.zip
FLUTTER_MACOS_ARM64_URL=https://storage.googleapis.com/flutter_infra_release/releases/stable/macos/flutter_macos_arm64_3.47.6-stable.zip

JULIA_URL=https://julialang-s3.julialang.org/bin/linux/x64/1.13/julia-1.13.0-linux-x86_64.tar.gz
CRYSTAL_URL=https://github.com/crystal-lang/crystal/releases/download/1.21.0/crystal-1.21.0-1-linux-x86_64.tar.gz
OPAM_URL=https://github.com/ocaml/opam/releases/download/2.6.0/opam-2.6.0-x86_64-linux
GHCUP_URL=https://downloads.haskell.org/~ghcup/0.2.6.2/x86_64-linux-ghcup-0.2.6.2
ZIG_URL=https://ziglang.org/download/0.16.0/zig-x86_64-linux-0.16.0.tar.xz
CPANM_URL=https://cpan.metacpan.org/authors/id/M/MI/MIYAGAWA/App-cpanminus-1.7049.tar.gz
LUA_URL=https://www.lua.org/ftp/lua-5.5.1.tar.gz
LUAROCKS_URL=https://luarocks.github.io/luarocks/releases/luarocks-3.13.0.tar.gz
# r: source build (CRAN). r-base would drag the whole apt stack, and the
# prebuilt binaries are access-restricted; compiling is deterministic.
R_URL=https://cran.r-project.org/src/base/R-4/R-4.6.1.tar.gz
# cc: C/C++ build tooling (no language registry).
CMAKE_URL=https://github.com/Kitware/CMake/releases/download/v4.4.3/cmake-4.4.3-linux-x86_64.tar.gz
NINJA_URL=https://github.com/ninja-build/ninja/releases/download/v1.13.2/ninja-linux.zip
